{
	"name": "modfolio-studio",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"packageManager": "bun@1.2.4",
	"scripts": {
		"quality:all": "bun run check && bun run typecheck && bun run typecheck:app && bash scripts/quality-gate.sh",
		"build": "cd apps/landing && bun run build",
		"build:app": "cd apps/app && bun run build",
		"dev": "cd apps/landing && bun run dev",
		"dev:app": "cd apps/app && bun run dev",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "cd apps/landing && bun run check",
		"typecheck:astro": "cd apps/landing && bun run check",
		"typecheck:app": "cd apps/app && bun run check",
		"harness-pull": "modfolio-harness-pull",
		"modfolio": "modfolio-check",
		"json-diff": "bun node_modules/@modfolio/harness/scripts/json-diff.ts",
		"check:audit": "bun node_modules/@modfolio/harness/scripts/check-audit.ts",
		"ts7:ready": "bun node_modules/@modfolio/harness/scripts/ci/ts7-readiness.ts",
		"verify:frozen-lockfile": "bun node_modules/@modfolio/harness/scripts/ci/frozen-lockfile.ts",
		"verify:no-nul": "bun node_modules/@modfolio/harness/scripts/ci/no-nul-bytes.ts",
		"heavy": "bash node_modules/@modfolio/harness/scripts/ops/heavy.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@modfolio/harness": "^3.56.1"
	},
	"overrides": {
		"@biomejs/cli-linux-x64-musl": "npm:@biomejs/cli-linux-x64@^2.5.2"
	},
	"dependencies": {
		"@modfolio/connect-sdk": "^9.5.0",
		"@modfolio/contracts": "^1.23.0"
	}
}
